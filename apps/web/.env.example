# Google Tag Manager
VITE_GTM_ID=GTM-NZKGV8R3

# Sentry (Error Tracking)
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Algolia browser search credentials (search-only keys only)
VITE_ALGOLIA_APP_ID=your-primary-algolia-app-id
VITE_ALGOLIA_SEARCH_KEY=your-primary-algolia-search-only-key
# Optional backup Algolia account used after an unusable primary failure
VITE_ALGOLIA_BACKUP_APP_ID=your-backup-algolia-app-id
VITE_ALGOLIA_BACKUP_SEARCH_KEY=your-backup-algolia-search-only-key

# API Configuration
VITE_COURSEWEB_API_URL=https://api.nthumods.com
VITE_API_TIMEOUT=30000

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_TRACKING=true

# App Environment
VITE_APP_ENV=development
