# `bun run setup` copies this file to .env.development.local. Vite ranks
# .env.development above .env.local, so a plain .env.local would NOT override
# the local-API default there. VITE_* values are shipped to the
# browser, so never put an admin key, service-role key, password, or token here.

# Read-only production services. These are the defaults used by frontend-only
# contributors; no local API, database, or maintainer secret is required.
# The production API rejects cross-origin requests from localhost, so the dev
# server proxies /__api to https://api.nthumods.com (see vite.config.ts).
# Change the port here if you start Vite on a port other than 5173, or set
# this to http://localhost:5001 when running services/api locally.
VITE_COURSEWEB_API_URL=http://localhost:5173/__api
VITE_NTHUMODS_AUTH_URL=https://auth.nthumods.com
VITE_AUTH_CLIENT_ID=nthumods
VITE_NTHUMODS_AUTH_REDIRECT=http://localhost:5173/auth/callback
VITE_NTHUMODS_AUTH_SILENT_REDIRECT=http://localhost:5173/auth/silent

# Public Supabase browser configuration. The anon key is intentionally public;
# it is not a service-role key.
VITE_SUPABASE_URL=https://cmzdlrqfpuktcczvsobs.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImNtemRscnFmcHVrdGNjenZzb2JzIiwicm9sZSI6ImFub24iLCJpYXQiOjE2OTkzNDAzNDMsImV4cCI6MjAxNDkxNjM0M30.SJwTEP3fUQ8emcwIZS8sRMC4eStYFrkk2rninsv8CqY

# Public Algolia search-only configuration. The fallback search API still
# works when these optional values are removed.
VITE_ALGOLIA_APP_ID=NT48R1WDTS
VITE_ALGOLIA_SEARCH_KEY=6dfe4655a78904f8b01432e7db3b8d64
# Optional backup search-only account; leave blank unless a maintainer gives
# you a second public search-only pair.
VITE_ALGOLIA_BACKUP_APP_ID=
VITE_ALGOLIA_BACKUP_SEARCH_KEY=

# Public testing key for the issue form. Production uses its own site key.
VITE_TURNSTILE_SITE_KEY=3x00000000000000000000FF

# Optional public analytics. GTM already has the same safe default in source.
VITE_GTM_ID=GTM-NZKGV8R3

# Keep the local-first course search opt-in until production verification is
# complete. Set to true only when you intentionally want to download the local
# search index.
VITE_ENABLE_LOCAL_SEARCH=false
