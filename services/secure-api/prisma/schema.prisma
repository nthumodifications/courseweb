datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Staff access to the admin center. Deliberately separate from OAuth scopes:
// scopes say what a *client application* may ask for on a user's behalf, this
// says what the *person* is allowed to do inside NTHUMods itself.
enum AdminRole {
  USER
  ADMIN
  SUPERUSER
}

model User {
  id                    String               @id @default(uuid())
  userId                String               @unique
  name                  String
  nameEn                String               @map("name_en")
  email                 String
  inschool              Boolean
  cid                   String?
  lmsid                 String?
  role                  AdminRole            @default(USER)
  banned                Boolean              @default(false)
  bannedReason          String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  authSessions          AuthSessions[]
  tokens                Token[]
  authCodes             AuthCode[]
  apiKeys               ApiKey[]
  calendarShareTokens   CalendarShareToken[]
  clientConsents        ClientConsent[]
  adminActions          AdminAuditLog[]
  courseReviews         CourseReview[]
  shortNameEdits        CourseShortName[] @relation("CourseShortNameEditor")
  shortNameRevisions    CourseShortNameRevision[]
  reviewReports         CourseReviewReport[] @relation("CourseReviewReportReporter")
  resolvedReviewReports CourseReviewReport[] @relation("CourseReviewReportResolver")
  classProfile            ClassPageProfile?
  classMemberships        ClassPageMembership[]
  classPageLinks          ClassPageLink[]
  classPageReports        ClassPageReport[]     @relation("ClassPageReportReporter")
  resolvedClassReports    ClassPageReport[]     @relation("ClassPageReportResolver")
  classPageBlocksMade     ClassPageBlock[]      @relation("ClassPageBlocker")
  classPageBlocksReceived ClassPageBlock[]      @relation("ClassPageBlocked")
}

model UserStorage {
  userId       String
  key          String
  value        Json
  updatedAt    Float?
  lastModified Float
  deviceId     String?

  @@id([userId, key])
  @@index([userId])
  @@map("user_storage")
}

// Every write an admin makes through the admin center lands here. Role changes
// and bans are the kind of action that has to be attributable after the fact,
// and the acting admin cannot edit or delete their own trail through the API.
model AdminAuditLog {
  id         String   @id @default(uuid())
  actorId    String
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User     @relation(fields: [actorId], references: [userId], onDelete: Cascade)

  @@index([createdAt])
  @@index([actorId])
}

model AuthCode {
  id                  String   @id @default(uuid())
  code                String   @unique
  userId              String
  clientId            String
  redirectUri         String
  scopes              String[]
  expiresAt           DateTime
  nonce               String?
  codeChallenge       String?
  codeChallengeMethod String?
  responseMode        String?
  responseType        String[]
  createdAt           DateTime @default(now())
  user                User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
}

model AuthRequest {
  id                  String       @id @default(uuid())
  sessionId           String
  clientId            String
  redirectUri         String
  scopes              String[]
  state               String?      @unique
  clientState         String?
  nonce               String?
  codeChallenge       String?
  codeChallengeMethod String?
  responseMode        String?
  responseType        String[]
  // Set when the user approves the consent screen. A request that has not been
  // approved is never exchanged for a code, so the existence of a row is not on
  // its own taken as consent.
  consentedAt         DateTime?
  createdAt           DateTime     @default(now())
  session             AuthSessions @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
}

enum TokenType {
  ACCESS
  REFRESH
}

model Token {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  type      TokenType
  clientId  String
  scopes    String[]
  expiresAt DateTime
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [userId], onDelete: Cascade)
}

enum AuthSessionState {
  UNAUTHENTICATED
  AUTHENTICATED
}

model AuthSessions {
  id              String           @id @default(uuid())
  sessionId       String           @unique
  createdAt       DateTime         @default(now())
  state           AuthSessionState
  expiresAt       DateTime
  userId          String?
  authenticatedAt DateTime?
  authRequests    AuthRequest[]
  user            User?            @relation(fields: [userId], references: [userId], onDelete: Cascade)
}

model Client {
  id           String   @id @default(uuid())
  clientId     String   @unique
  name         String? // Display name shown on the consent screen
  clientUri    String? // Homepage shown on the consent screen
  firstParty   Boolean  @default(false) // NTHUMods' own clients
  redirectUris String[]
  logoutUris   String[]
  clientSecret String? // Optional, for confidential clients
  scopes       String[]

  consents ClientConsent[]
}

// A user's standing grant of a scope set to a client. Recorded when the user
// approves the consent screen; checked before any authorization code is issued.
model ClientConsent {
  id        String   @id @default(uuid())
  userId    String
  clientId  String
  scopes    String[]
  grantedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  client    Client   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)

  @@unique([userId, clientId])
}

model ApiKey {
  id         String    @id @default(uuid())
  name       String
  key        String    @unique
  scopes     String[]
  expiresAt  DateTime?
  userId     String
  user       User      @relation(fields: [userId], references: [userId], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  isRevoked  Boolean   @default(false)
}

model CalendarShareToken {
  id                 String    @id @default(uuid())
  name               String
  tokenHash          String    @unique
  userId             String
  user               User      @relation(fields: [userId], references: [userId], onDelete: Cascade)
  includeFullDetails Boolean   @default(false)
  expiresAt          DateTime?
  revokedAt          DateTime?
  createdAt          DateTime  @default(now())
  lastUsedAt         DateTime?
}

enum CourseReviewStatus {
  VISIBLE
  HIDDEN
  REMOVED
}

enum CourseReviewSource {
  NATIVE
  PTT
}

enum CourseReviewReportReason {
  PERSONAL_ATTACK
  EXAM_LEAK
  SPAM
  OFF_TOPIC
  OTHER
}

model CourseReview {
  id            String               @id @default(uuid())
  userId        String?
  moduleKey     String
  instructor    String
  semester      String?
  coolness      Int?
  sweetness     Int?
  learning      Int?
  attendance    String?
  examStyle     String[]
  body          String
  source        CourseReviewSource   @default(NATIVE)
  sourceUrl     String?
  sourceAuthor  String?
  sourcePostedAt DateTime?
  status        CourseReviewStatus   @default(VISIBLE)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  user          User?                @relation(fields: [userId], references: [userId], onDelete: Cascade)
  reports    CourseReviewReport[]

  @@unique([userId, moduleKey, instructor])
  @@unique([sourceUrl, instructor])
  @@index([moduleKey])
  @@index([instructor])
  @@index([source])
}

model CourseReviewReport {
  id           String                   @id @default(uuid())
  reviewId     String
  reason       CourseReviewReportReason
  note         String?
  reporterId   String
  createdAt    DateTime                 @default(now())
  resolvedAt   DateTime?
  resolvedById String?
  review       CourseReview             @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporter     User                     @relation("CourseReviewReportReporter", fields: [reporterId], references: [userId], onDelete: Cascade)
  resolvedBy   User?                    @relation("CourseReviewReportResolver", fields: [resolvedById], references: [userId], onDelete: SetNull)

  @@unique([reviewId, reporterId])
  @@index([reviewId])
  @@index([resolvedAt])
}

model ClassPageProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  displayName        String
  department         String
  year               String
  contacts           Json     @default("[]")
  displayNameVisible Boolean  @default(true)
  departmentVisible  Boolean  @default(true)
  yearVisible        Boolean  @default(true)
  contactsVisible    Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  memberships        ClassPageMembership[]
}

model ClassPageMembership {
  id                 String            @id @default(uuid())
  userId             String
  profileId          String
  semester           String
  courseId           String
  selfDeclared       Boolean           @default(true)
  lookingForPartners Boolean           @default(false)
  createdAt          DateTime          @default(now())
  user               User              @relation(fields: [userId], references: [userId], onDelete: Cascade)
  profile            ClassPageProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  links              ClassPageLink[]
  reports            ClassPageReport[] @relation("ClassPageMemberReports")

  @@unique([userId, semester, courseId])
  @@index([profileId])
  @@index([semester, courseId])
}

enum ClassPageLinkStatus {
  VISIBLE
  HIDDEN
}

model ClassPageLink {
  id           String              @id @default(uuid())
  authorId     String
  membershipId String
  label        String
  url          String
  status       ClassPageLinkStatus @default(VISIBLE)
  createdAt    DateTime            @default(now())
  author       User                @relation(fields: [authorId], references: [userId], onDelete: Cascade)
  membership   ClassPageMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  reports      ClassPageReport[]

  @@index([membershipId, status])
}

enum ClassPageReportTargetType {
  MEMBER
  LINK
}

enum ClassPageReportReason {
  SPAM
  HARASSMENT
  PERSONAL_INFO
  OTHER
}

model ClassPageReport {
  id               String                    @id @default(uuid())
  reporterId       String
  targetType       ClassPageReportTargetType
  membershipId     String?
  linkId           String?
  targetUserId     String?
  targetSemester   String
  targetCourseId   String
  reason           ClassPageReportReason
  note             String?
  createdAt        DateTime                  @default(now())
  resolvedAt       DateTime?
  resolvedById     String?
  reporter         User                      @relation("ClassPageReportReporter", fields: [reporterId], references: [userId], onDelete: Cascade)
  resolvedBy       User?                     @relation("ClassPageReportResolver", fields: [resolvedById], references: [userId], onDelete: SetNull)
  targetMembership ClassPageMembership?      @relation("ClassPageMemberReports", fields: [membershipId], references: [id], onDelete: SetNull)
  targetLink       ClassPageLink?            @relation(fields: [linkId], references: [id], onDelete: SetNull)

  @@unique([reporterId, membershipId])
  @@unique([reporterId, linkId])
  @@index([resolvedAt])
  @@index([targetType, createdAt])
  @@index([targetUserId])
}

model ClassPageBlock {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("ClassPageBlocker", fields: [blockerId], references: [userId], onDelete: Cascade)
  blocked   User     @relation("ClassPageBlocked", fields: [blockedId], references: [userId], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

enum CourseShortNameIdentityType {
  MODULE
  COURSE_CODE
}

enum CourseShortNameLanguage {
  ZH
  EN
}

model CourseShortName {
  id           String                      @id @default(uuid())
  identityType CourseShortNameIdentityType
  identityKey  String
  language     CourseShortNameLanguage
  shortName    String
  locked       Boolean                     @default(false)
  updatedById  String
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
  updatedBy    User                        @relation("CourseShortNameEditor", fields: [updatedById], references: [userId], onDelete: Restrict)
  revisions    CourseShortNameRevision[]

  @@unique([identityType, identityKey, language])
  @@index([updatedById])
  @@map("course_short_names")
}

// Revisions are inserted for every name edit and admin revert. The API never
// updates or deletes these rows, preserving the editor and previous value.
model CourseShortNameRevision {
  id        String          @id @default(uuid())
  entryId   String
  editorId  String
  shortName String
  action    String          @default("EDIT")
  createdAt DateTime        @default(now())
  entry     CourseShortName @relation(fields: [entryId], references: [id], onDelete: Restrict)
  editor    User            @relation(fields: [editorId], references: [userId], onDelete: Restrict)

  @@index([entryId, createdAt])
  @@index([editorId, createdAt])
  @@map("course_short_name_revisions")
}
