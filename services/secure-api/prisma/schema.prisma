datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Staff access to the admin center. Deliberately separate from OAuth scopes:
// scopes say what a *client application* may ask for on a user's behalf, this
// says what the *person* is allowed to do inside NTHUMods itself.
enum AdminRole {
  USER
  ADMIN
  SUPERUSER
}

enum OrganisationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum OrganisationMemberRole {
  OWNER
  MANAGER
  APPROVER
}

enum SpaceWhoCanBook {
  ANYONE_SIGNED_IN
  NTHU_ONLY
  MEMBERS
  ALLOW_LIST
}

enum SpaceApprovalMode {
  APPROVAL
  INSTANT
}

enum BookingStatus {
  REQUESTED
  APPROVED
  REJECTED
  CANCELLED
  NO_SHOW
}

model User {
  id                    String               @id @default(uuid())
  userId                String               @unique
  name                  String
  nameEn                String               @map("name_en")
  email                 String
  inschool              Boolean
  cid                   String?
  lmsid                 String?
  role                  AdminRole            @default(USER)
  banned                Boolean              @default(false)
  bannedReason          String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  authSessions          AuthSessions[]
  tokens                Token[]
  authCodes             AuthCode[]
  apiKeys               ApiKey[]
  calendarShareTokens   CalendarShareToken[]
  clientConsents        ClientConsent[]
  adminActions          AdminAuditLog[]
  courseReviews         CourseReview[]
  shortNameEdits        CourseShortName[] @relation("CourseShortNameEditor")
  shortNameRevisions    CourseShortNameRevision[]
  reviewReports         CourseReviewReport[] @relation("CourseReviewReportReporter")
  resolvedReviewReports CourseReviewReport[] @relation("CourseReviewReportResolver")
  createdOrganisations  Organisation[] @relation("OrganisationCreator")
  organisationMemberships OrganisationMember[]
  bookings              Booking[] @relation("BookingUser")
  decidedBookings       Booking[] @relation("BookingDecider")
  spaceAllowListEntries SpaceBookingAllowList[]
}

model UserStorage {
  userId       String
  key          String
  value        Json
  updatedAt    Float?
  lastModified Float
  deviceId     String?

  @@id([userId, key])
  @@index([userId])
  @@map("user_storage")
}

// Every write an admin makes through the admin center lands here. Role changes
// and bans are the kind of action that has to be attributable after the fact,
// and the acting admin cannot edit or delete their own trail through the API.
model AdminAuditLog {
  id         String   @id @default(uuid())
  actorId    String
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User     @relation(fields: [actorId], references: [userId], onDelete: Cascade)

  @@index([createdAt])
  @@index([actorId])
}

model AuthCode {
  id                  String   @id @default(uuid())
  code                String   @unique
  userId              String
  clientId            String
  redirectUri         String
  scopes              String[]
  expiresAt           DateTime
  nonce               String?
  codeChallenge       String?
  codeChallengeMethod String?
  responseMode        String?
  responseType        String[]
  createdAt           DateTime @default(now())
  user                User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
}

model AuthRequest {
  id                  String       @id @default(uuid())
  sessionId           String
  clientId            String
  redirectUri         String
  scopes              String[]
  state               String?      @unique
  clientState         String?
  nonce               String?
  codeChallenge       String?
  codeChallengeMethod String?
  responseMode        String?
  responseType        String[]
  // Set when the user approves the consent screen. A request that has not been
  // approved is never exchanged for a code, so the existence of a row is not on
  // its own taken as consent.
  consentedAt         DateTime?
  createdAt           DateTime     @default(now())
  session             AuthSessions @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
}

enum TokenType {
  ACCESS
  REFRESH
}

model Token {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  type      TokenType
  clientId  String
  scopes    String[]
  expiresAt DateTime
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [userId], onDelete: Cascade)
}

enum AuthSessionState {
  UNAUTHENTICATED
  AUTHENTICATED
}

model AuthSessions {
  id              String           @id @default(uuid())
  sessionId       String           @unique
  createdAt       DateTime         @default(now())
  state           AuthSessionState
  expiresAt       DateTime
  userId          String?
  authenticatedAt DateTime?
  authRequests    AuthRequest[]
  user            User?            @relation(fields: [userId], references: [userId], onDelete: Cascade)
}

model Client {
  id           String   @id @default(uuid())
  clientId     String   @unique
  name         String? // Display name shown on the consent screen
  clientUri    String? // Homepage shown on the consent screen
  firstParty   Boolean  @default(false) // NTHUMods' own clients
  redirectUris String[]
  logoutUris   String[]
  clientSecret String? // Optional, for confidential clients
  scopes       String[]

  consents ClientConsent[]
}

// A user's standing grant of a scope set to a client. Recorded when the user
// approves the consent screen; checked before any authorization code is issued.
model ClientConsent {
  id        String   @id @default(uuid())
  userId    String
  clientId  String
  scopes    String[]
  grantedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  client    Client   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)

  @@unique([userId, clientId])
}

model ApiKey {
  id         String    @id @default(uuid())
  name       String
  key        String    @unique
  scopes     String[]
  expiresAt  DateTime?
  userId     String
  user       User      @relation(fields: [userId], references: [userId], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  isRevoked  Boolean   @default(false)
}

model CalendarShareToken {
  id                 String    @id @default(uuid())
  name               String
  tokenHash          String    @unique
  userId             String
  user               User      @relation(fields: [userId], references: [userId], onDelete: Cascade)
  includeFullDetails Boolean   @default(false)
  expiresAt          DateTime?
  revokedAt          DateTime?
  createdAt          DateTime  @default(now())
  lastUsedAt         DateTime?
}

enum CourseReviewStatus {
  VISIBLE
  HIDDEN
  REMOVED
}

enum CourseReviewSource {
  NATIVE
  PTT
}

enum CourseReviewReportReason {
  PERSONAL_ATTACK
  EXAM_LEAK
  SPAM
  OFF_TOPIC
  OTHER
}

model CourseReview {
  id            String               @id @default(uuid())
  userId        String?
  moduleKey     String
  instructor    String
  semester      String?
  coolness      Int?
  sweetness     Int?
  learning      Int?
  attendance    String?
  examStyle     String[]
  body          String
  source        CourseReviewSource   @default(NATIVE)
  sourceUrl     String?
  sourceAuthor  String?
  sourcePostedAt DateTime?
  status        CourseReviewStatus   @default(VISIBLE)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  user          User?                @relation(fields: [userId], references: [userId], onDelete: Cascade)
  reports    CourseReviewReport[]

  @@unique([userId, moduleKey, instructor])
  @@unique([sourceUrl, instructor])
  @@index([moduleKey])
  @@index([instructor])
  @@index([source])
}

model CourseReviewReport {
  id           String                   @id @default(uuid())
  reviewId     String
  reason       CourseReviewReportReason
  note         String?
  reporterId   String
  createdAt    DateTime                 @default(now())
  resolvedAt   DateTime?
  resolvedById String?
  review       CourseReview             @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporter     User                     @relation("CourseReviewReportReporter", fields: [reporterId], references: [userId], onDelete: Cascade)
  resolvedBy   User?                    @relation("CourseReviewReportResolver", fields: [resolvedById], references: [userId], onDelete: SetNull)

  @@unique([reviewId, reporterId])
  @@index([reviewId])
  @@index([resolvedAt])
}

enum CourseShortNameIdentityType {
  MODULE
  COURSE_CODE
}

enum CourseShortNameLanguage {
  ZH
  EN
}

model CourseShortName {
  id           String                      @id @default(uuid())
  identityType CourseShortNameIdentityType
  identityKey  String
  language     CourseShortNameLanguage
  shortName    String
  locked       Boolean                     @default(false)
  updatedById  String
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
  updatedBy    User                        @relation("CourseShortNameEditor", fields: [updatedById], references: [userId], onDelete: Restrict)
  revisions    CourseShortNameRevision[]

  @@unique([identityType, identityKey, language])
  @@index([updatedById])
  @@map("course_short_names")
}

// Revisions are inserted for every name edit and admin revert. The API never
// updates or deletes these rows, preserving the editor and previous value.
model CourseShortNameRevision {
  id        String          @id @default(uuid())
  entryId   String
  editorId  String
  shortName String
  action    String          @default("EDIT")
  createdAt DateTime        @default(now())
  entry     CourseShortName @relation(fields: [entryId], references: [id], onDelete: Restrict)
  editor    User            @relation(fields: [editorId], references: [userId], onDelete: Restrict)

  @@index([entryId, createdAt])
  @@index([editorId, createdAt])
  @@map("course_short_name_revisions")
}

model Organisation {
  id                 String               @id @default(uuid())
  name               String
  slug               String               @unique
  description        String
  contact            String
  status             OrganisationStatus   @default(PENDING)
  createdBy          String               @map("created_by")
  discordWebhookUrl  String?              @map("discord_webhook_url")
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  creator            User                 @relation("OrganisationCreator", fields: [createdBy], references: [userId], onDelete: Restrict)
  members            OrganisationMember[]
  spaces             Space[]

  @@index([status, createdAt])
  @@map("organisation")
}

model OrganisationMember {
  id              String                 @id @default(uuid())
  organisationId  String                 @map("organisation_id")
  userId          String                 @map("user_id")
  role            OrganisationMemberRole @default(APPROVER)
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  organisation    Organisation           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user            User                   @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([organisationId, userId])
  @@index([userId, role])
  @@map("organisation_member")
}

model Space {
  id                       String               @id @default(uuid())
  organisationId           String               @map("organisation_id")
  slug                     String
  name                     String
  description              String
  location                 String
  venueId                  String?              @map("venue_id")
  isPublic                 Boolean              @default(true) @map("is_public")
  rules                    String
  whoCanBook               SpaceWhoCanBook      @default(ANYONE_SIGNED_IN) @map("who_can_book")
  approvalMode             SpaceApprovalMode    @default(APPROVAL) @map("approval_mode")
  slotLengthMinutes        Int                  @default(60) @map("slot_length_minutes")
  minNoticeHours           Int                  @default(0) @map("min_notice_hours")
  maxLengthMinutes         Int                  @default(240) @map("max_length_minutes")
  maxActiveBookingsPerUser Int                  @default(3) @map("max_active_bookings_per_user")
  requireBorrowingUnit      Boolean              @default(false) @map("require_borrowing_unit")
  requirePurpose            Boolean              @default(true) @map("require_purpose")
  requireHeadcount          Boolean              @default(false) @map("require_headcount")
  archivedAt                DateTime?            @map("archived_at") @db.Timestamptz(3)
  createdAt                 DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  organisation              Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  openingHours              SpaceOpeningHours[]
  blackouts                 SpaceBlackout[]
  allowList                 SpaceBookingAllowList[]
  bookings                  Booking[]

  @@unique([organisationId, slug])
  @@index([organisationId, archivedAt])
  @@map("space")
}

model SpaceOpeningHours {
  id        String   @id @default(uuid())
  spaceId   String   @map("space_id")
  weekday   Int
  opensAt   String   @map("opens_at")
  closesAt  String   @map("closes_at")
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, weekday])
  @@map("space_opening_hours")
}

model SpaceBlackout {
  id        String   @id @default(uuid())
  spaceId   String   @map("space_id")
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  reason    String?
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([spaceId, startDate, endDate])
  @@map("space_blackout")
}

model SpaceBookingAllowList {
  id        String   @id @default(uuid())
  spaceId   String   @map("space_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([spaceId, userId])
  @@map("space_booking_allow_list")
}

model Booking {
  id             String        @id @default(uuid())
  spaceId        String        @map("space_id")
  userId         String        @map("user_id")
  startAt        DateTime      @map("start_at") @db.Timestamptz(3)
  endAt          DateTime      @map("end_at") @db.Timestamptz(3)
  status         BookingStatus @default(REQUESTED)
  borrowingUnit  String?       @map("borrowing_unit")
  purpose        String?
  headcount      Int?
  notes          String?
  decidedBy      String?       @map("decided_by")
  decidedAt      DateTime?     @map("decided_at") @db.Timestamptz(3)
  reason         String?
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  space          Space         @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user           User          @relation("BookingUser", fields: [userId], references: [userId], onDelete: Cascade)
  decider        User?         @relation("BookingDecider", fields: [decidedBy], references: [userId], onDelete: SetNull)
  events         BookingEvent[]

  @@index([spaceId, startAt, endAt])
  @@index([userId, status, startAt])
  @@map("booking")
}

model BookingEvent {
  id          String   @id @default(uuid())
  bookingId   String   @map("booking_id")
  whoUserId   String?  @map("who_user_id")
  what        String
  at          DateTime @default(now()) @map("at") @db.Timestamptz(3)
  details     Json?
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, at])
  @@map("booking_event")
}
