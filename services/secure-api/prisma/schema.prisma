datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Staff access to the admin center. Deliberately separate from OAuth scopes:
// scopes say what a *client application* may ask for on a user's behalf, this
// says what the *person* is allowed to do inside NTHUMods itself.
enum AdminRole {
  USER
  ADMIN
  SUPERUSER
}

model User {
  id                    String               @id @default(uuid())
  userId                String               @unique
  name                  String
  nameEn                String               @map("name_en")
  email                 String
  inschool              Boolean
  cid                   String?
  lmsid                 String?
  role                  AdminRole            @default(USER)
  banned                Boolean              @default(false)
  bannedReason          String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  authSessions          AuthSessions[]
  tokens                Token[]
  authCodes             AuthCode[]
  apiKeys               ApiKey[]
  calendarShareTokens   CalendarShareToken[]
  clientConsents        ClientConsent[]
  adminActions          AdminAuditLog[]
  courseReviews         CourseReview[]
  reviewReports         CourseReviewReport[] @relation("CourseReviewReportReporter")
  resolvedReviewReports CourseReviewReport[] @relation("CourseReviewReportResolver")
}

model UserStorage {
  userId       String
  key          String
  value        Json
  updatedAt    Float?
  lastModified Float
  deviceId     String?

  @@id([userId, key])
  @@index([userId])
  @@map("user_storage")
}

// Every write an admin makes through the admin center lands here. Role changes
// and bans are the kind of action that has to be attributable after the fact,
// and the acting admin cannot edit or delete their own trail through the API.
model AdminAuditLog {
  id         String   @id @default(uuid())
  actorId    String
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User     @relation(fields: [actorId], references: [userId], onDelete: Cascade)

  @@index([createdAt])
  @@index([actorId])
}

model AuthCode {
  id                  String   @id @default(uuid())
  code                String   @unique
  userId              String
  clientId            String
  redirectUri         String
  scopes              String[]
  expiresAt           DateTime
  nonce               String?
  codeChallenge       String?
  codeChallengeMethod String?
  responseMode        String?
  responseType        String[]
  createdAt           DateTime @default(now())
  user                User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
}

model AuthRequest {
  id                  String       @id @default(uuid())
  sessionId           String
  clientId            String
  redirectUri         String
  scopes              String[]
  state               String?      @unique
  clientState         String?
  nonce               String?
  codeChallenge       String?
  codeChallengeMethod String?
  responseMode        String?
  responseType        String[]
  // Set when the user approves the consent screen. A request that has not been
  // approved is never exchanged for a code, so the existence of a row is not on
  // its own taken as consent.
  consentedAt         DateTime?
  createdAt           DateTime     @default(now())
  session             AuthSessions @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
}

enum TokenType {
  ACCESS
  REFRESH
}

model Token {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  type      TokenType
  clientId  String
  scopes    String[]
  expiresAt DateTime
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [userId], onDelete: Cascade)
}

enum AuthSessionState {
  UNAUTHENTICATED
  AUTHENTICATED
}

model AuthSessions {
  id              String           @id @default(uuid())
  sessionId       String           @unique
  createdAt       DateTime         @default(now())
  state           AuthSessionState
  expiresAt       DateTime
  userId          String?
  authenticatedAt DateTime?
  authRequests    AuthRequest[]
  user            User?            @relation(fields: [userId], references: [userId], onDelete: Cascade)
}

model Client {
  id           String   @id @default(uuid())
  clientId     String   @unique
  name         String? // Display name shown on the consent screen
  clientUri    String? // Homepage shown on the consent screen
  firstParty   Boolean  @default(false) // NTHUMods' own clients
  redirectUris String[]
  logoutUris   String[]
  clientSecret String? // Optional, for confidential clients
  scopes       String[]

  consents ClientConsent[]
}

// A user's standing grant of a scope set to a client. Recorded when the user
// approves the consent screen; checked before any authorization code is issued.
model ClientConsent {
  id        String   @id @default(uuid())
  userId    String
  clientId  String
  scopes    String[]
  grantedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  client    Client   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)

  @@unique([userId, clientId])
}

model ApiKey {
  id         String    @id @default(uuid())
  name       String
  key        String    @unique
  scopes     String[]
  expiresAt  DateTime?
  userId     String
  user       User      @relation(fields: [userId], references: [userId], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  isRevoked  Boolean   @default(false)
}

model CalendarShareToken {
  id                 String    @id @default(uuid())
  name               String
  tokenHash          String    @unique
  userId             String
  user               User      @relation(fields: [userId], references: [userId], onDelete: Cascade)
  includeFullDetails Boolean   @default(false)
  expiresAt          DateTime?
  revokedAt          DateTime?
  createdAt          DateTime  @default(now())
  lastUsedAt         DateTime?
}

enum CourseReviewStatus {
  VISIBLE
  HIDDEN
  REMOVED
}

enum CourseReviewSource {
  NATIVE
  PTT
}

enum CourseReviewReportReason {
  PERSONAL_ATTACK
  EXAM_LEAK
  SPAM
  OFF_TOPIC
  OTHER
}

model CourseReview {
  id            String               @id @default(uuid())
  userId        String?
  moduleKey     String
  instructor    String
  semester      String?
  coolness      Int?
  sweetness     Int?
  learning      Int?
  attendance    String?
  examStyle     String[]
  body          String
  source        CourseReviewSource   @default(NATIVE)
  sourceUrl     String?
  sourceAuthor  String?
  sourcePostedAt DateTime?
  status        CourseReviewStatus   @default(VISIBLE)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  user          User?                @relation(fields: [userId], references: [userId], onDelete: Cascade)
  reports    CourseReviewReport[]

  @@unique([userId, moduleKey, instructor])
  @@unique([sourceUrl, instructor])
  @@index([moduleKey])
  @@index([instructor])
  @@index([source])
}

model CourseReviewReport {
  id           String                   @id @default(uuid())
  reviewId     String
  reason       CourseReviewReportReason
  note         String?
  reporterId   String
  createdAt    DateTime                 @default(now())
  resolvedAt   DateTime?
  resolvedById String?
  review       CourseReview             @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporter     User                     @relation("CourseReviewReportReporter", fields: [reporterId], references: [userId], onDelete: Cascade)
  resolvedBy   User?                    @relation("CourseReviewReportResolver", fields: [resolvedById], references: [userId], onDelete: SetNull)

  @@unique([reviewId, reporterId])
  @@index([reviewId])
  @@index([resolvedAt])
}
